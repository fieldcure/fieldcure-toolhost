<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.1.8</Version>
    <AssemblyName>FieldCure.ToolHost.Cli</AssemblyName>
    <RootNamespace>FieldCure.ToolHost.Cli</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <RollForward>LatestMajor</RollForward>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fcdnx</ToolCommandName>

    <!-- NuGet Package Metadata -->
    <PackageId>FieldCure.ToolHost.Cli</PackageId>
    <Description>fcdnx — Run .NET tools from NuGet without the .NET SDK. A dnx-compatible CLI bridge for runtime-only environments. Tracking https://github.com/dotnet/sdk/issues/49796 for the eventual official solution.</Description>
    <Authors>Jong Hyun Kim</Authors>
    <Company>Fieldcure Co., Ltd.</Company>
    <Copyright>Copyright (c) 2026 Fieldcure Co., Ltd.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/fieldcure/fieldcure-toolhost</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dnx;dotnet-tool;nuget;fcdnx;tool-runner;sdk-less;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>v0.1.8 — Forwards stdin to the launched tool and bridges stdio with raw byte copies, so long-lived stdio servers (e.g. MCP) receive requests and stay connected. Previously the child's stdin was closed at startup, causing stdio servers to shut down immediately after connecting. Completes the MCP-hosting fix begun in v0.1.7 (stderr logging). See RELEASENOTES.ToolHost.Cli.md on GitHub for the full notes.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldCure.ToolHost\FieldCure.ToolHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FieldCure.ToolHost.Cli.Tests" />
  </ItemGroup>

</Project>
