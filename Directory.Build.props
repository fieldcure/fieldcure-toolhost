<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      NU1507 — multiple package sources warning (we ship our own NuGet.Config in CI).
      CA1848 / CA1873 — source-generated logger machinery is overkill for our log volume;
                        we still hand-roll LoggerMessage.Define for truly hot paths.
    -->
    <NoWarn>$(NoWarn);NU1507;CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>FieldCure</Authors>
    <Company>FieldCure Co., Ltd.</Company>
    <Copyright>Copyright (c) FieldCure Co., Ltd. and contributors.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fieldcure/fieldcure-toolhost</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fieldcure/fieldcure-toolhost</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
